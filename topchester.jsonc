{
  "$schema": "https://topchester.com/schemas/config.v1.json",
  "ignore": {
    "paths": ["docs/**/*.md", "pnpm-lock.yaml", ".agents/**/*.md"],
  },
  "tools": {
    "bash": {
      "allowExact": [
        "node --version",
        "mise run local-ci",
        "oxfmt topchester.jsonc",
        "mise local-ci",
        "pnpm format",
        "pwd && node --version",
        "node -e 'const pkg = JSON.parse(require(\"fs\").readFileSync(\"package.json\", \"utf8\")); console.log(JSON.stringify(pkg.scripts, null, 2))'",
        "wc -l src/agent/tools/bash.ts src/agent/tools/bash-policy.ts",
        "find src -type f -exec du -h {} + | sort -rh | head -n 10",
        "wc -l src/tui/layout.ts src/tui/*.ts src/agent/*.ts | sort -rn",
        "mcp_everything_echo \"mcp works\"",
        "echo \"mcp works\"",
        "mise run test",
        "mise run package-check",
        "mise run format-check",
        "mise run typecheck",
        "mise run lint",
        "mise run opentui-pty-smoke",
        "mise run format-check && mise run typecheck && mise run test-node && mise run opentui-test",
        "mise run typecheck && mise run test-node && mise run opentui-test",
        "mise run opentui-test",
        "mise run format-check; format_status=$?; mise run lint; lint_status=$?; exit $((format_status || lint_status))",
        "mise run format",
        "mise run format-check && mise run typecheck && mise run lint && mise run test-node && mise run opentui-test",
        "mise run format && mise run format-check && mise run typecheck && mise run lint && mise run test-node && mise run opentui-test",
        "git push",
        "gh workflow run publish-npm.yml --ref main -f release=minor && gh run list --workflow publish-npm.yml --event workflow_dispatch --limit 1 --json databaseId,url,status,conclusion,headBranch,createdAt,displayTitle",
        "gh run view 32938079201 --json databaseId,url,status,conclusion,headBranch,displayTitle,event",
        "git push && gh workflow run publish-npm.yml --ref main -f release=minor && gh run list --workflow publish-npm.yml --event workflow_dispatch --limit 1 --json databaseId,url,status,conclusion,headBranch,createdAt,displayTitle",
        "gh run view 32938328401 --json databaseId,url,status,conclusion,headBranch,displayTitle,event",
      ],
    },
  },
}
