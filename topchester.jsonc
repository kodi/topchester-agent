{
  "$schema": "https://topchester.com/schemas/config.v1.json",
  "ignore": {
    "paths": ["docs/**/*.md", "pnpm-lock.yaml", ".agents/**/*.md"],
  },
  "tools": {
    "commands": {
      "allowExact": ["node --version", "mise run local-ci", "oxfmt topchester.jsonc", "mise local-ci", "pnpm format"],
    },
  },
}
