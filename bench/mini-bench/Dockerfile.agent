FROM node:24-bookworm-slim

ARG TOPCHESTER_NPM_SPEC=topchester-ai@latest
RUN apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
RUN npm install -g "${TOPCHESTER_NPM_SPEC}"
WORKDIR /workspace

CMD ["topchester", "--help"]
