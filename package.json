{
  "name": "topchester-ai",
  "version": "0.92.0",
  "private": true,
  "description": "Terminal-native TUI coding agent tightly coupled to a project knowledge base.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kodi/topchester-agent"
  },
  "bin": {
    "topchester": "dist/bin.mjs"
  },
  "workspaces": {
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
      "vite-plus": "0.2.4"
    }
  },
  "files": [
    "dist",
    "skills",
    "agents.json"
  ],
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:standalone": "bun scripts/build-standalone.ts",
    "build:standalone:all": "bun scripts/build-standalone.ts --all",
    "build:npm-release": "node --import tsx scripts/package/build-npm-release.ts",
    "build:npm-release:all": "node --import tsx scripts/package/build-npm-release.ts --all",
    "prepare:standalone-targets": "node --import tsx scripts/standalone/install-target-dependencies.ts",
    "dev": "bun src/bin.ts dev --config config/example.jsonc",
    "format": "vp fmt .",
    "format-check": "vp fmt . --check",
    "prepare": "vp config --no-agent",
    "benchmark:l1-search": "tsx scripts/benchmark/l1-search.ts",
    "mini-bench": "node bench/mini-bench/src/cli.ts",
    "mini-bench:list": "node bench/mini-bench/src/cli.ts list",
    "mini-bench:verify-fixtures": "node bench/mini-bench/src/cli.ts verify-fixtures",
    "format:check": "vp fmt . --check",
    "lint": "vp lint",
    "smoke": "tsx scripts/smoke/run-smoke.ts",
    "test": "vp test run --dir test && bun scripts/opentui/production-test.tsx",
    "typecheck": "vp check --no-fmt --no-lint",
    "check": "vp check && pnpm test",
    "release:build": "vp run prepare:standalone-targets && vp run build:standalone:all && vp run build:npm-release:all",
    "release:publish": "node --import tsx scripts/package/publish-npm-release.ts",
    "package-check": "node --import tsx scripts/package/check-package-contents.ts",
    "standalone-check": "node --import tsx scripts/package/check-standalone.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "0.4.4",
    "@opentui/solid": "0.4.4",
    "ai": "^6.0.196",
    "commander": "^15.0.0",
    "htmlparser2": "^12.0.0",
    "picomatch": "^4.0.4",
    "pino": "^10.3.1",
    "solid-js": "1.9.12",
    "turndown": "^7.2.4",
    "uuidv7": "1.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^24.12.3",
    "@types/picomatch": "^4.0.3",
    "@types/turndown": "^5.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tinybench": "^6.0.2",
    "tsx": "^4.22.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vite-plugin-solid": "2.11.10",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "pnpm@11.0.8"
}
