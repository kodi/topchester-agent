{
  "name": "topchester-ai",
  "version": "0.19.0",
  "private": false,
  "description": "Terminal-native TUI coding agent tightly coupled to a project knowledge base.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kodi/topchester-agent"
  },
  "bin": {
    "topchester": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown src/cli.ts --format esm --dts --out-dir dist --clean --sourcemap",
    "dev": "tsx src/cli.ts dev --config config/example.yaml",
    "format": "oxfmt .",
    "format-check": "oxfmt . --check",
    "hooks:install": "lefthook install",
    "benchmark:l1-search": "tsx scripts/benchmark/l1-search.ts",
    "format:check": "pnpm format-check",
    "lint": "oxlint",
    "smoke": "tsx scripts/smoke/run-smoke.ts",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "check": "pnpm typecheck && pnpm format-check && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@earendil-works/pi-tui": "^0.74.0",
    "ai": "^6.0.177",
    "cli-highlight": "^2.1.11",
    "commander": "^14.0.3",
    "picomatch": "^4.0.4",
    "pino": "^10.3.1",
    "uuidv7": "1.2.1",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/picomatch": "^4.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260513.1",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "tinybench": "^6.0.2",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.0.8"
}
