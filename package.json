{
  "name": "topchester-ai",
  "version": "0.69.0",
  "private": false,
  "description": "Terminal-native TUI coding agent tightly coupled to a project knowledge base.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kodi/topchester-agent"
  },
  "bin": {
    "topchester": "dist/bin.mjs"
  },
  "files": [
    "dist",
    "skills",
    "agents.json"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown src/bin.ts src/cli.ts --format esm --dts --out-dir dist --clean --sourcemap",
    "dev": "tsx src/bin.ts dev --config config/example.jsonc",
    "format": "oxfmt .",
    "format-check": "oxfmt . --check",
    "hooks:install": "lefthook install",
    "benchmark:l1-search": "tsx scripts/benchmark/l1-search.ts",
    "mini-bench": "node bench/mini-bench/src/cli.ts",
    "mini-bench:list": "node bench/mini-bench/src/cli.ts list",
    "mini-bench:verify-fixtures": "node bench/mini-bench/src/cli.ts verify-fixtures",
    "format:check": "pnpm format-check",
    "lint": "oxlint",
    "smoke": "tsx scripts/smoke/run-smoke.ts",
    "test": "vitest run --dir test",
    "typecheck": "tsgo --noEmit",
    "check": "pnpm typecheck && pnpm format-check && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@earendil-works/pi-tui": "^0.78.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.196",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "picomatch": "^4.0.4",
    "pino": "^10.3.1",
    "uuidv7": "1.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/picomatch": "^4.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260603.1",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tinybench": "^6.0.2",
    "tsdown": "^0.22.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.0.8"
}
